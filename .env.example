# Dominio publico de la app (Traefik Host)
DOMAIN=viajes.ntcpadel.com
# Nombre de la red Docker externa de Traefik en tu VPS.
# Compruebala con: docker network ls  (y docker inspect del contenedor Traefik)
# Si Traefik comparte la red por defecto de otro compose, pon ese nombre aqui.
TRAEFIK_NETWORK=web
